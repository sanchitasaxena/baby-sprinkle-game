# Keep the generator's private JSON source and local Cloudflare artifacts out
# of git. The intentionally shareable answer key is frontend/Don't Peek/.
worker/roster-data.json
worker/.dev.vars
worker/.wrangler/

# Node
node_modules/

# OS cruft
.DS_Store

# Old flat photo dump at repo root / legacy game folder — superseded by
# frontend/ + worker/. Keep out of new commits.
*.zip

# Legacy client-side prototype with identifying photo filenames. The static
# site uses only opaque filenames under frontend/images/.
game/

# Real-name-labeled source photos dumped at the repo root (e.g. GLENN.png,
# RUSSEL.jpg, SANCHITA.jpeg...). These are also prepare-assets.js source
# input, superseded for publishing by the opaque p-*.{ext} copies in
# frontend/images/. Never commit — filenames alone would give away answers.
*.jpg
*.jpeg
*.JPG
*.JPEG
*.png
*.webp
!frontend/images/**
